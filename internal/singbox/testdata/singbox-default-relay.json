{
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local"
      }
    ],
    "final": "local"
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 10808
    },
    {
      "type": "http",
      "tag": "http-in",
      "listen": "127.0.0.1",
      "listen_port": 10809
    },
    {
      "type": "socks",
      "tag": "mixed-extra",
      "listen": "127.0.0.1",
      "listen_port": 10810
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 20002,
      "username": "u",
      "password": "p",
      "version": "5"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      },
      {
        "outbound": "direct",
        "ip_is_private": true
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-private",
          "geosite-cn"
        ]
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "geosite-category-ads-all",
        "format": "binary",
        "path": "/rules/geosite-category-ads-all.srs"
      },
      {
        "type": "local",
        "tag": "geosite-cn",
        "format": "binary",
        "path": "/rules/geosite-cn.srs"
      },
      {
        "type": "local",
        "tag": "geosite-private",
        "format": "binary",
        "path": "/rules/geosite-private.srs"
      }
    ],
    "final": "proxy",
    "default_domain_resolver": "local"
  }
}
